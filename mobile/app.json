{
  "expo": {
    "name": "mmGO",
    "slug": "mmogo",
    "owner": "lekinguks-team",
    "scheme": "mmgo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F0E2",
    "android": {
      "package": "com.mmgo.app",
      "backgroundColor": "#1F2250",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "mmGO uses your camera to take the photo that proves you visited a landmark.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "mmGO checks your location to confirm you're at a landmark when you stamp it."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F2250"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supabaseUrl": "https://pianamkdbfwuxrlacgcy.supabase.co",
      "supabasePublishableKey": "sb_publishable_6YGf13h9hHy4eHZTc7-IZA_Gv_v7Yyl",
      "eas": {
        "projectId": "bdde5942-bfaf-4da4-be70-5a9097aaa4c8"
      }
    }
  }
}
